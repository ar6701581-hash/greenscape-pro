# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Gemini AI API Configuration
GEMINI_API_KEY=your-gemini-api-key-here
# Optional: override model (defaults to gemini-2.0-flash)
# GEMINI_MODEL=gemini-3.6-flash

# Slack Incoming Webhook (server-side only — never expose to the browser)
# Create at: https://api.slack.com/apps → Incoming Webhooks → Add New Webhook to Workspace
# Leave as placeholder or unset to silently skip notifications (safe for local/demo runs)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR_TEAM_ID/YOUR_CHANNEL_ID/YOUR_WEBHOOK_TOKEN

# Application URL (used to generate proposal deep-links in Slack messages)
# Set to your production domain when deploying, e.g. https://greenscape.example.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Tax Rate (0.0 = no tax; expressed as a decimal fraction, e.g. 0.086 = 8.6%)
TAX_RATE=0.0
